<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 keeps the package usable from .NET Framework / older
         consumers; net10.0 gets the modern BCL. Shared settings (nullable,
         warnings-as-errors, repository metadata) live in Directory.Build.props. -->
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>TypstRender.Client</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>TypstRender.Client</PackageId>
    <Description>HTTP client for the Typst rendering service: zips a Typst project, posts it, returns the rendered PDF. The Typst binary lives in the service, never in this package.</Description>
    <PackageTags>typst;pdf;rendering;client;document-generation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Ship XML docs so consumers get IntelliSense, and a .snupkg so they can
         step into this code from their debugger. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
    <!-- OptionsBuilder.Bind, for the AddTypstRenderClient(IConfiguration) overload. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <!-- Compiled directly in rather than referenced as a project/package: the published
       client must be self-contained, with no dependency on a TypstRender.Contracts
       package that's never published on its own. -->
  <ItemGroup>
    <Compile Include="..\TypstRender.Contracts\RenderProtocol.cs" Link="Internal\RenderProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TypstRender.Client.Tests" />
  </ItemGroup>

</Project>
