{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Render": {
    "TypstBinaryPath": "typst",
    "TimeoutSeconds": 30,
    "MaxUploadBytes": 20971520,
    "MaxExtractedBytes": 209715200,
    "MaxBundleEntries": 2000,
    "MaxConcurrency": 0,
    "QueueTimeoutSeconds": 10,
    "ShutdownTimeoutSeconds": 45
  }
}
