<Project>

  <!-- Settings shared by every project in the repository. Keep project files to
       what is genuinely project-specific (target framework, package refs). -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Reproducible builds: a consumer stepping into the package with SourceLink
       needs the compiler to emit paths that do not depend on the build machine. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == '' and '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Dependency auditing: on, and reporting everything down to low severity,
       but the line between "stop the build" and "raise a warning" is drawn by
       severity rather than by TreatWarningsAsErrors promoting all four codes.
       High and critical (NU1903/NU1904) block a build, because they must never
       reach a release. Low and moderate (NU1901/NU1902) stay warnings: they are
       usually a transitive dependency of a sample, nothing in this repo can fix
       them until upstream ships a patch, and a hard failure there is what forced
       CI to exclude the sample project to dodge NU1903 in the first place — so
       one advisory in one dev-only package blocked all work. Dependabot raises
       the bump; see .github/dependabot.yml. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Shared package identity. Per-package metadata (id, description, tags)
       stays in the packable project. -->
  <PropertyGroup>
    <Authors>Gilles Wetzel</Authors>
    <Company>Gilles Wetzel</Company>
    <Copyright>Copyright (c) Gilles Wetzel</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wetgi/csharp-typst</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wetgi/csharp-typst.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

</Project>
